# Copy this file to .env (same folder) and put your own Gemini API key in it.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: more keys (one Google project each) are tried in order when one is used up:
# GEMINI_IMAGE_PROJECT_1_KEY=
# GEMINI_IMAGE_PROJECT_2_KEY=

# Optional: only if Gemini needs a proxy on this PC (e.g. v2rayN). "none" = always direct.
# GEMINI_PROXY=http://127.0.0.1:10808

# Optional: Edge TTS (the Burmese voice) normally needs NO proxy - Microsoft refuses many VPN servers (403).
# Only on a network where the voice works just through a proxy: EDGE_TTS_PROXY=http://127.0.0.1:<port>
# EDGE_TTS_PROXY=

# Optional: the Whisper model (~460 MB, first run only) comes from huggingface.co. No account or
# HF_TOKEN is needed. Only if huggingface.co does not open on this PC, use a mirror:
# HF_ENDPOINT=https://hf-mirror.com
